{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Site Blocker",
  "mainBinaryName": "SiteBlocker",
  "version": "0.1.0",
  "identifier": "com.siteblocker.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Site Blocker",
        "width": 340,
        "height": 720,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Site Blocker",
    "shortDescription": "Blocks distracting sites in Chromium browsers and Obsidian",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
