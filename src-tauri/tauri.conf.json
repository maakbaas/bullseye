{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bullseye",
  "mainBinaryName": "bullseye-app",
  "version": "0.1.0",
  "identifier": "com.bullseye.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bullseye",
    "shortDescription": "A distraction blocker for Windows that you can hold yourself to",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
